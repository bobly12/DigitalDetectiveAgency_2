@* Views/Board/Index.cshtml *@
@model DigitalDetectiveAgency.Models.ViewModels.BoardViewModel

@{
    ViewData["Title"] = "Investigation Board";
}

<h1>🧵 Investigation Board — @Model.CaseTitle</h1>
<p class="text-muted">Click a card, then click another card to draw a connection. Click an existing line to remove it.</p>

<div id="board-container" style="position: relative; min-height: 600px; border: 1px dashed #999; padding: 20px;">
    <svg id="connection-svg" style="position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none;"></svg>

    <div class="row">
        <div class="col-md-4">
            <h5>🔍 Evidence</h5>
            @foreach (var node in Model.Evidence)
            {
                <div class="board-card card mb-2 p-2" data-type="Evidence" data-id="@node.Id">
                    <strong>@node.Name</strong>
                </div>
            }
        </div>
        <div class="col-md-4">
            <h5>🕴️ Suspects</h5>
            @foreach (var node in Model.Suspects)
            {
                <div class="board-card card mb-2 p-2" data-type="Suspect" data-id="@node.Id">
                    <strong>@node.Name</strong>
                </div>
            }
        </div>
        <div class="col-md-4">
            <h5>🗣️ Witnesses</h5>
            @foreach (var node in Model.Witnesses)
            {
                <div class="board-card card mb-2 p-2" data-type="Witness" data-id="@node.Id">
                    <strong>@node.Name</strong>
                </div>
            }
        </div>
    </div>
</div>

<a asp-controller="Case" asp-action="Details" asp-route-id="@Model.CaseId" class="btn btn-secondary mt-3">Back to Case</a>

@section Scripts {
    <script>
        window.boardCaseId = @Model.CaseId;
        window.initialConnections = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Connections));
    </script>
    <script src="~/js/board.js"></script>
}