@* Views/AdminCase/Edit.cshtml *@
@model DigitalDetectiveAgency.Models.ViewModels.CaseFormViewModel

<div class="container mt-4">
    <h1>Edit Case: @Model.Title</h1>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="Difficulty" class="form-label"></label>
            <select asp-for="Difficulty" class="form-select" asp-items="Html.GetEnumSelectList<DigitalDetectiveAgency.Models.Entities.CaseDifficulty>()"></select>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsPublished" class="form-check-input" />
            <label asp-for="IsPublished" class="form-check-label">Published</label>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>

    <hr />
    <p class="text-muted">
        Evidence, Suspects, and Witnesses aren't listed here yet — add them directly via
        <code>/Admin/Evidence/Create/@Model.Id</code>, <code>/Admin/Suspect/Create/@Model.Id</code>,
        <code>/Admin/Witness/Create/@Model.Id</code> for now. A linked list view here is a good Phase 10 polish item.
    </p>
</div>