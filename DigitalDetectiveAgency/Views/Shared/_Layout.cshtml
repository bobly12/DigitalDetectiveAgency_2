<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Digital Detective Agency</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Inter:wght@400;500&family=Caveat:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("PageStyles", required: false)
</head>
<body>
    <header>
        <nav class="dossier-nav">
            <a class="dossier-nav__brand" asp-area="" asp-controller="Home" asp-action="Index">
                🕵️ Digital Detective Agency
            </a>
            <ul class="dossier-nav__links">
                <li><a asp-controller="Profile" asp-action="Index">Profile</a></li>
                <li><a asp-controller="Case" asp-action="Index">Case Files</a></li>
                <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="dossier-nav__admin"><a asp-controller="AdminCase" asp-action="Index">🛠 Admin</a></li>
                }
            </ul>
            <partial name="_LoginPartial" />
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="dossier-footer">
        <div>&copy; 2026 Digital Detective Agency — Confidential Case Files — <a asp-controller="Home" asp-action="Privacy">Privacy</a></div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>