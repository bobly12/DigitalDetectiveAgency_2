@model DigitalDetectiveAgency.Models.ViewModels.AccusationFormViewModel

@{
    ViewData["Title"] = "Make Your Accusation";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/accusation.css" asp-append-version="true" />
}

<div class="container-interrogation">
    <div class="interrogation-panel">
        <h1 class="interrogation-title">Who Is the Culprit?</h1>
        <div class="interrogation-warning">⚠ This accusation is final. Choose carefully, Detective.</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary-errors">
                <ul style="margin:0; padding-left: 1.2rem;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Create" method="post" id="accusation-form">
            <input type="hidden" name="CaseId" value="@Model.CaseId" />

            <div class="suspect-lineup">
                @foreach (var suspect in Model.Suspects)
                {
                    <label class="suspect-select-card" data-suspect-card>
                        <img src="@suspect.ImageUrl" alt="@suspect.Name" />
                        <div class="suspect-select-card__body">
                            <input type="radio" name="SuspectId" value="@suspect.Id" required />
                            <strong>@suspect.Name</strong>
                            <p>@suspect.Description</p>
                        </div>
                    </label>
                }
            </div>

            <button type="submit" class="btn-stamp btn-stamp--danger">Submit Accusation</button>
        </form>

        <div style="margin-top: var(--space-md);">
            <a asp-controller="Case" asp-action="Details" asp-route-id="@Model.CaseId" class="btn-stamp btn-stamp--ghost">
                ← Back to Case File
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Visually highlight the selected suspect card
        document.querySelectorAll('[data-suspect-card]').forEach(card => {
            card.addEventListener('click', () => {
                document.querySelectorAll('[data-suspect-card]').forEach(c => c.classList.remove('is-checked'));
                card.classList.add('is-checked');
            });
        });
    </script>
}