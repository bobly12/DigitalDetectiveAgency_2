@* Views/Accusation/Create.cshtml *@
@model DigitalDetectiveAgency.Models.ViewModels.AccusationFormViewModel

@{
    ViewData["Title"] = "Make Your Accusation";
}

<div class="container mt-4">
    <h1>⚖️ Make Your Accusation</h1>
    <p class="text-muted">Case: @Model.CaseTitle</p>
    <div class="alert alert-warning">This is final — you cannot change your accusation once submitted.</div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Create" method="post">
        <input type="hidden" name="CaseId" value="@Model.CaseId" />

        <div class="row">
            @foreach (var suspect in Model.Suspects)
            {
                <div class="col-md-4 mb-3">
                    <label class="card h-100" style="cursor:pointer;">
                        <img src="@suspect.ImageUrl" class="card-img-top" alt="@suspect.Name" style="height:200px;object-fit:cover;" />
                        <div class="card-body">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="SuspectId" value="@suspect.Id" required />
                                <label class="form-check-label"><strong>@suspect.Name</strong></label>
                            </div>
                            <p class="card-text mt-2">@suspect.Description</p>
                        </div>
                    </label>
                </div>
            }
        </div>

        <button type="submit" class="btn btn-danger btn-lg mt-3">Submit Accusation</button>
    </form>

    <a asp-controller="Case" asp-action="Details" asp-route-id="@Model.CaseId" class="btn btn-secondary mt-3">Back to Case</a>
</div>