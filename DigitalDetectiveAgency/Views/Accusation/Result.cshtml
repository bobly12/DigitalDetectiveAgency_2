@model DigitalDetectiveAgency.Models.ViewModels.AccusationResultViewModel

@{
    ViewData["Title"] = "Case Closed";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/results.css" asp-append-version="true" />
}

<div class="container-report">
    <div class="report-stamp-card">
        @if (Model.WasCorrect)
        {
            <div class="report-verdict report-verdict--solved">CASE SOLVED ✓</div>
            <p class="report-accused">You correctly identified <strong>@Model.AccusedSuspectName</strong> as the culprit in "@Model.CaseTitle."</p>
        }
        else
        {
            <div class="report-verdict report-verdict--unsolved">CASE UNSOLVED ✕</div>
            <p class="report-accused">You accused <strong>@Model.AccusedSuspectName</strong>, but that wasn't the culprit in "@Model.CaseTitle."</p>
        }

        <div class="report-gauge">
            <div class="report-gauge__label">Final Score</div>
            <div class="report-gauge__track">
                <div class="report-gauge__fill @(Model.Score >= 70 ? "report-gauge__fill--high" : Model.Score >= 40 ? "report-gauge__fill--mid" : "report-gauge__fill--low")"
                     style="width: @Model.Score%;">
                    @Model.Score / 100
                </div>
            </div>
        </div>

        <div class="report-gauge">
            <div class="report-gauge__label">Case Strength (Board Accuracy)</div>
            <div class="report-gauge__track">
                <div class="report-gauge__fill @(Model.CaseStrengthPercent >= 70 ? "report-gauge__fill--high" : Model.CaseStrengthPercent >= 40 ? "report-gauge__fill--mid" : "report-gauge__fill--low")"
                     style="width: @Model.CaseStrengthPercent%;">
                    @Model.CaseStrengthPercent%
                </div>
            </div>
        </div>

        <p class="report-note">Score = 70% accusation accuracy + 30% investigation board accuracy.</p>
    </div>

    <div style="margin-top: var(--space-lg);">
        <a asp-controller="Case" asp-action="Index" class="btn-stamp btn-stamp--primary">Back to Case Archive</a>
    </div>
</div>