@model IEnumerable<DigitalDetectiveAgency.Models.ViewModels.CaseListItemViewModel>

@{
    ViewData["Title"] = "Cases";
}

<div class="container mt-4">
    <h1 class="mb-4">🕵️ Your Assigned Cases</h1>

    @if (!Model.Any())
    {
        <p class="text-muted">No cases have been assigned to you yet. Check back soon, detective.</p>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@item.Title</h5>
                            <h6 class="card-subtitle mb-2 text-muted">Difficulty: @item.Difficulty</h6>
                            <p class="card-text">@item.Description</p>
                        </div>
                        <div class="card-footer bg-transparent border-top-0">
                            @if (item.IsCompleted)
                            {
                                <span class="badge bg-success mb-2 d-block">Completed (Score: @item.Score)</span>
                            }
                            else if (item.IsOpened)
                            {
                                <span class="badge bg-warning text-dark mb-2 d-block">In Progress</span>
                            }
                            else
                            {
                                <span class="badge bg-primary mb-2 d-block">New</span>
                            }

                            <a asp-controller="Case" asp-action="Details" asp-route-id="@item.CaseId" class="btn btn-primary w-100">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>