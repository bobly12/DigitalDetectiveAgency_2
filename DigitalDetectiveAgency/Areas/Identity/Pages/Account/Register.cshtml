@page
@model RegisterModel

@{
    ViewData["Title"] = "Join the Agency";
}

<div class="container-interrogation" style="max-width: 500px;">
    <div class="form-paper">
        <h2>🕵️ Detective Recruitment</h2>
        <p style="text-align:center; color:#6b6b6b; font-size:0.85rem; margin-bottom:1.5rem;">
            Fill out your intake form to join the agency.
        </p>

        <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <label asp-for="Input.DetectiveName"></label>
            <input asp-for="Input.DetectiveName" autocomplete="username" placeholder="Detective Name" />
            <span asp-validation-for="Input.DetectiveName" class="text-danger" style="font-size:0.8rem;"></span>

            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" autocomplete="username" placeholder="name@example.com" />
            <span asp-validation-for="Input.Email" class="text-danger" style="font-size:0.8rem;"></span>

            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" type="password" autocomplete="new-password" placeholder="Password" />
            <span asp-validation-for="Input.Password" class="text-danger" style="font-size:0.8rem;"></span>

            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="Confirm Password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size:0.8rem;"></span>

            <button type="submit" class="btn-stamp btn-stamp--primary" style="width:100%; margin-top:1rem;">
                Join the Agency
            </button>
        </form>

        <div style="text-align:center; margin-top:1rem; font-size:0.85rem;">
            <p>Already a detective? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}