@* Views/AdminSuspect/Create.cshtml *@
@model DigitalDetectiveAgency.Models.ViewModels.SuspectFormViewModel

<div class="container mt-4">
    <h1>Add Suspect</h1>
    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="CaseId" />
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" required /></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="2" required></textarea></div>
        <div class="mb-3"><label asp-for="Motive" class="form-label"></label><textarea asp-for="Motive" class="form-control" rows="2"></textarea></div>
        <div class="mb-3"><label asp-for="Alibi" class="form-label"></label><textarea asp-for="Alibi" class="form-control" rows="2"></textarea></div>
        <div class="mb-3"><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" class="form-control" /></div>
        <div class="form-check mb-3">
            <input asp-for="IsGuilty" class="form-check-input" />
            <label asp-for="IsGuilty" class="form-check-label">This suspect is guilty (answer key)</label>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-controller="AdminCase" asp-action="Edit" asp-route-id="@Model.CaseId" class="btn btn-secondary">Back to Case</a>
    </form>
</div>