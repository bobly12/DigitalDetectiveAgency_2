@{
    ViewData["Title"] = "Headquarters";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />
}

<div class="container-hq">
    <div class="hq-hero">
        <h1>DIGITAL DETECTIVE AGENCY</h1>
        <p>Every case has a story. Every clue tells the truth — if you know where to look.</p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Case" asp-action="Index" class="btn-stamp btn-stamp--primary">
                View Your Cases
            </a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Register" class="btn-stamp btn-stamp--primary">
                Join the Agency
            </a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn-stamp btn-stamp--ghost">
                Detective Login
            </a>
        }

        <div class="hq-hero__stats">Cases Solved: 14 | Rank: Detective</div>
    </div>

    <div class="hq-features">
        <div class="hq-feature-card">
            <div class="hq-feature-card__icon"></div>
            <h5>Gather Evidence</h5>
            <p>Examine every clue left behind. Nothing is too small to matter.</p>
        </div>
        <div class="hq-feature-card">
            <div class="hq-feature-card__icon"></div>
            <h5>Connect the Clues</h5>
            <p>Use the Investigation Board to link evidence, suspects, and witnesses.</p>
        </div>
        <div class="hq-feature-card">
            <div class="hq-feature-card__icon"></div>
            <h5>Make the Call</h5>
            <p>Submit your accusation. Get it right, and close the case for good.</p>
        </div>
    </div>
</div>