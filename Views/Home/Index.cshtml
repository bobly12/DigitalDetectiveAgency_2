@{
    ViewData["Title"] = "Digital Detective Agency";
    ViewData["MusicVolume"] = 50;
}
@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />
}
<section class="hero-noir">
    <div class="hero-noir__content">
        <h1 class="hero-noir__title">
            Every Case<br />
            Has A<br />
            Killer Detail
        </h1>
        <p class="hero-noir__subtitle">
            Connect the evidence. Break the alibi. Catch the one who did it —
            not just the one who looks guilty.
        </p>
        <a asp-controller="Case" asp-action="Index" class="btn-stamp btn-stamp--danger hero-noir__cta">
            🔍 Start Investigating
        </a>
    </div>
    <div class="hero-noir__image">
        <img src="~/images/home/noir-landing.png" alt="Detective corkboard with magnifying glass" />
    </div>
</section>
