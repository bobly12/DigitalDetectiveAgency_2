@model DigitalDetectiveAgency.Models.ViewModels.AccusationResultViewModel

@{
ViewData["Title"] = "Case Closed";
}

@section PageStyles {
<link rel="stylesheet" href="~/css/pages/result.css" asp-append-version="true" />
}

<div class="container-narrow">
    <div class="report-stamp-card">
        @if (Model.WasCorrect)
        {
        <div class="mugshot-frame" id="mugshot-frame">
            <img src="@Model.AccusedSuspectImageUrl" alt="@Model.AccusedSuspectName" class="mugshot-frame__photo" />
            <div class="mugshot-frame__stamp" id="mugshot-stamp">GUILTY<br />SOLVED</div>
        </div>
        <div class="report-verdict report-verdict--solved" id="beat-verdict">CASE SOLVED ✓</div>
        <p class="report-accused" id="beat-accused">You correctly identified <strong>@Model.AccusedSuspectName</strong> as the culprit in "@Model.CaseTitle."</p>
        }
        else
        {
        <div class="mugshot-frame mugshot-frame--wrong" id="mugshot-frame">
            <img src="@Model.AccusedSuspectImageUrl" alt="@Model.AccusedSuspectName" class="mugshot-frame__photo" />
            <div class="mugshot-frame__stamp mugshot-frame__stamp--wrong" id="mugshot-stamp-wrong">NOT<br />GUILTY</div>
        </div>
        <div class="report-verdict report-verdict--unsolved" id="beat-verdict">@(Model.CaseClosed ? "CASE UNSOLVED ✕" : "WRONG SUSPECT ✕")</div>
        <p class="report-accused" id="beat-accused">You accused <strong>@Model.AccusedSuspectName</strong>, but that wasn't the culprit in "@Model.CaseTitle."</p>
        }

        <div class="tries-indicator" id="beat-tries">
            @for (var i = 0; i < Model.MaxAttempts; i++)
            {
            <span class="tries-indicator__dot @(i < Model.AttemptsUsed ? "tries-indicator__dot--used" : "")"></span>
            }
            <span class="tries-indicator__label">
                @(Model.WasCorrect ? "Solved" : Model.CaseClosed ? "No tries left" : $"{Model.AttemptsRemaining} of {Model.MaxAttempts} tries left")
            </span>
        </div>

        <p class="report-summary" id="beat-summary">@Model.DetectiveSummary</p>

        <div class="report-gauge" id="beat-score">
            <div class="report-gauge__label">Final Score</div>
            <div class="report-gauge__track">
                <div class="report-gauge__fill @(Model.Score >= 70 ? "report-gauge__fill--high" : Model.Score >= 40 ? "report-gauge__fill--mid" : "report-gauge__fill--low")"
                     id="score-fill" data-target-width="@Model.Score">
                    @Model.Score / 100
                </div>
                <div class="report-gauge__value-overlay">@Model.Score / 100</div>
            </div>
        </div>

        <div class="report-gauge" id="beat-strength">
            <div class="report-gauge__label">Case Strength (Board Accuracy)</div>
            <div class="report-gauge__track">
                <div class="report-gauge__fill @(Model.CaseStrengthPercent >= 70 ? "report-gauge__fill--high" : Model.CaseStrengthPercent >= 40 ? "report-gauge__fill--mid" : "report-gauge__fill--low")"
                     id="strength-fill" data-target-width="@Model.CaseStrengthPercent">
                    @Model.CaseStrengthPercent%
                </div>
                <div class="report-gauge__value-overlay">@Model.CaseStrengthPercent%</div>
            </div>
        </div>

        <p class="report-note" id="beat-note">Score = 70% accusation accuracy + 30% investigation board accuracy.</p>
    </div>

    <div style="margin-top: var(--space-lg); display: flex; gap: var(--space-sm); flex-wrap: wrap;">
        @if (!Model.CaseClosed)
        {
        <a asp-controller="Accusation" asp-action="Create" asp-route-id="@Model.CaseId" class="btn-stamp btn-stamp--danger">Try Again</a>
        <a asp-controller="Board" asp-action="Index" asp-route-id="@Model.CaseId" class="btn-stamp btn-stamp--ghost">Back to the Board</a>
        }
        else
        {
        <a asp-controller="Case" asp-action="Index" class="btn-stamp btn-stamp--primary">Back to Case Archive</a>
        }
    </div>
</div>

@section Scripts {
<script>
    (function () {
        function playVictoryChime() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const notes = [523.25, 659.25, 783.99, 1046.50]; // C5 E5 G5 C6
                notes.forEach((freq, i) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.value = freq;
                    const start = ctx.currentTime + i * 0.09;
                    gain.gain.setValueAtTime(0, start);
                    gain.gain.linearRampToValueAtTime(0.18, start + 0.01);
                    gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.35);
                    osc.connect(gain).connect(ctx.destination);
                    osc.start(start);
                    osc.stop(start + 0.4);
                });
            } catch { /* ignore */ }
        }

        function playTick() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'square';
                osc.frequency.value = 900;
                gain.gain.setValueAtTime(0.08, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.08);
                osc.connect(gain).connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.1);
            } catch { /* ignore */ }
        }

        function reveal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.add('is-revealed');
        }

        function fillBar(id) {
            const el = document.getElementById(id);
            if (!el) return;
            const target = Math.max(0, Math.min(100, parseFloat(el.dataset.targetWidth) || 0));
            el.style.width = '0%';
            el.classList.add('is-filled');
            // Force a reflow so the browser registers the 0% start before
            // animating to the real target - without this, some browsers
            // collapse the 0% -> target% transition into a single frame.
            void el.offsetWidth;
            requestAnimationFrame(() => { el.style.width = target + '%'; });
        }

        const stamp = document.getElementById('mugshot-stamp');
        const wrongStamp = document.getElementById('mugshot-stamp-wrong');
        const wasCorrect = !!stamp;

        function playWrongThud() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(180, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(60, ctx.currentTime + 0.3);
                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.35);
                osc.connect(gain).connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.4);
            } catch { /* ignore */ }
        }

        // The beat sequence: verdict -> stamp slam (guilty chime / wrong thud) -> tries -> summary -> score bar -> strength bar -> note
        const beats = wasCorrect
            ? [
                { delay: 200, run: () => reveal('beat-verdict') },
                { delay: 500, run: () => { stamp.classList.add('is-stamped'); playVictoryChime(); } },
                { delay: 1200, run: () => reveal('beat-accused') },
                { delay: 1500, run: () => reveal('beat-tries') },
                { delay: 1700, run: () => reveal('beat-summary') },
                { delay: 2100, run: () => { reveal('beat-score'); fillBar('score-fill'); playTick(); } },
                { delay: 2600, run: () => { reveal('beat-strength'); fillBar('strength-fill'); playTick(); } },
                { delay: 3100, run: () => reveal('beat-note') }
            ]
            : [
                { delay: 200, run: () => reveal('beat-verdict') },
                { delay: 500, run: () => { if (wrongStamp) { wrongStamp.classList.add('is-stamped'); playWrongThud(); } } },
                { delay: 1000, run: () => reveal('beat-accused') },
                { delay: 1300, run: () => reveal('beat-tries') },
                { delay: 1600, run: () => reveal('beat-summary') },
                { delay: 2000, run: () => { reveal('beat-score'); fillBar('score-fill'); } },
                { delay: 2500, run: () => { reveal('beat-strength'); fillBar('strength-fill'); } },
                { delay: 3000, run: () => reveal('beat-note') }
            ];

        beats.forEach(b => setTimeout(b.run, b.delay));
    })();
</script>
}
