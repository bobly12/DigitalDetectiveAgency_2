@model DigitalDetectiveAgency.Models.ViewModels.AccusationFormViewModel

@{
    ViewData["Title"] = "Make Your Accusation";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/accusation.css" asp-append-version="true" />
}

<div class="container-interrogation">
    <div class="interrogation-panel">
        <h1 class="interrogation-title">Who Is the Culprit?</h1>
        <div class="interrogation-warning">⚠ Choose carefully, Detective.</div>
        <div class="tries-indicator" id="tries-indicator">
            @for (var i = 0; i < Model.MaxAttempts; i++)
            {
                <span class="tries-indicator__dot @(i < Model.AttemptsUsed ? "tries-indicator__dot--used" : "")"></span>
            }
            <span class="tries-indicator__label">@Model.AttemptsRemaining of @Model.MaxAttempts tries left</span>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary-errors">
                <ul style="margin:0; padding-left: 1.2rem;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Create" method="post" id="accusation-form">
            <input type="hidden" name="CaseId" value="@Model.CaseId" />

            <div class="suspect-lineup">
                @foreach (var suspect in Model.Suspects)
                {
                    var alreadyWrong = Model.WrongSuspectIds.Contains(suspect.Id);
                    <label class="suspect-select-card @(alreadyWrong ? "suspect-select-card--ruled-out" : "")" data-suspect-card data-suspect-name="@suspect.Name">
                        <img src="@suspect.ImageUrl" alt="@suspect.Name" />
                        <div class="suspect-select-card__body">
                            <input type="radio" name="SuspectId" value="@suspect.Id" required disabled="@(alreadyWrong ? "disabled" : null)" />
                            <strong>@suspect.Name</strong>
                            <p>@suspect.Description</p>
                            @if (alreadyWrong)
                            {
                                <span class="suspect-select-card__ruled-out-tag">✕ Already ruled out</span>
                            }
                        </div>
                    </label>
                }
            </div>

            <button type="submit" class="btn-stamp btn-stamp--danger" id="submit-accusation-btn">Submit Accusation</button>
        </form>

        <div style="margin-top: var(--space-md);">
            <a asp-controller="Case" asp-action="Details" asp-route-id="@Model.CaseId" class="btn-stamp btn-stamp--ghost">
                ← Back to Case File
            </a>
        </div>
    </div>
</div>

<div class="accusation-confirm-overlay" id="accusation-confirm-overlay">
    <div class="accusation-confirm-box">
        <h2>Final Answer?</h2>
        <p>You're about to accuse <strong id="confirm-suspect-name"></strong>.</p>
        <p class="accusation-confirm-warning">This cannot be undone. @(Model.AttemptsRemaining <= 1 ? "This is your last try — if you're wrong, the case closes." : $"If you're wrong, you'll have {Model.AttemptsRemaining - 1} tries left.")</p>
        <div class="accusation-confirm-actions">
            <button type="button" class="btn-stamp btn-stamp--ghost" id="confirm-cancel-btn">Go Back</button>
            <button type="button" class="btn-stamp btn-stamp--danger" id="confirm-submit-btn">Yes, Accuse Them</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const form = document.getElementById('accusation-form');
        const overlay = document.getElementById('accusation-confirm-overlay');
        const nameEl = document.getElementById('confirm-suspect-name');
        let selectedName = '';

        // Visually highlight the selected suspect card
        document.querySelectorAll('[data-suspect-card]').forEach(card => {
            card.addEventListener('click', (e) => {
                if (card.classList.contains('suspect-select-card--ruled-out')) {
                    e.preventDefault();
                    return;
                }
                window.GameAudio?.playNavClick();
                document.querySelectorAll('[data-suspect-card]').forEach(c => c.classList.remove('is-checked'));
                card.classList.add('is-checked');
                selectedName = card.dataset.suspectName;
            });
        });

        // Intercept submit: show confirmation instead of posting immediately
        form.addEventListener('submit', (e) => {
            if (overlay.classList.contains('is-submitting')) return; // already confirmed, let it through
            e.preventDefault();

            if (!form.querySelector('input[name="SuspectId"]:checked')) {
                alert('Select a suspect before submitting.');
                return;
            }

            nameEl.textContent = selectedName || 'this suspect';
            overlay.classList.add('is-visible');
        });

        document.getElementById('confirm-cancel-btn').addEventListener('click', () => {
            overlay.classList.remove('is-visible');
        });

        document.getElementById('confirm-submit-btn').addEventListener('click', () => {
            overlay.classList.add('is-submitting');
            form.requestSubmit();
        });

        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) overlay.classList.remove('is-visible');
        });
    </script>
}