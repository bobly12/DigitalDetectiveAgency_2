@* Views/AdminEvidence/Edit.cshtml *@
@model DigitalDetectiveAgency.Models.ViewModels.EvidenceFormViewModel

<div class="container mt-4">
    <h1>Edit Evidence</h1>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CaseId" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label"></label>
            <input asp-for="ImageUrl" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-controller="AdminCase" asp-action="Edit" asp-route-id="@Model.CaseId" class="btn btn-secondary">Back to Case</a>
    </form>
</div>