@model DigitalDetectiveAgency.Models.ViewModels.CaseDetailViewModel

@{
    ViewData["Title"] = Model.Title;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/case-details.css" asp-append-version="true" />
}

<div class="container-dossier">

    @if (Model.IsCompleted)
    {
        <div class="dossier-completed-banner"> Case Closed — Score: @Model.Score</div>
    }

    <div class="dossier-sheet">
        <div class="dossier-sheet__photo">
            <img src="https://placehold.co/240x300?text=Case+File" alt="@Model.Title" />
        </div>
        <div>
            <h1 class="dossier-sheet__title">@Model.Title</h1>
            <div class="dossier-sheet__difficulty">Difficulty: @Model.Difficulty</div>
            <p class="dossier-sheet__description">@Model.Description</p>
        </div>
    </div>

    <div class="dossier-actions">
        <a asp-controller="Board" asp-action="Index" asp-route-id="@Model.CaseId" class="btn-stamp btn-stamp--ghost">
            🧵 Open Investigation Board
        </a>
        @if (!Model.IsCompleted)
        {
            <a asp-controller="Accusation" asp-action="Create" asp-route-id="@Model.CaseId" class="btn-stamp btn-stamp--danger">
                ⚖️ Make Accusation
            </a>
        }
    </div>

    <div class="dossier-section-title">🔍 Evidence</div>
    @if (!Model.Evidence.Any())
    {
        <p class="text-muted">No evidence has been logged for this case yet.</p>
    }
    else
    {
        <div class="dossier-grid">
            @foreach (var item in Model.Evidence)
            {
                var fields = new[] { new { heading = (string?)null, text = item.Description } };
                <div class="dossier-item-card is-clickable"
                     data-name="@item.Name"
                     data-image="@item.ImageUrl"
                     data-label="Evidence"
                     data-fields="@System.Text.Json.JsonSerializer.Serialize(fields)">
                    <img src="@item.ImageUrl" alt="@item.Name" />
                    <div class="dossier-item-card__body">
                        <h6>@item.Name</h6>
                        <p>@(item.Description.Length > 80 ? item.Description.Substring(0, 80) + "…" : item.Description)</p>
                    </div>
                </div>
            }
        </div>
    }

    <div class="dossier-section-title">🕴 Suspects</div>
    @if (!Model.Suspects.Any())
    {
        <p class="text-muted">No suspects identified yet.</p>
    }
    else
    {
        <div class="dossier-grid">
            @foreach (var s in Model.Suspects)
            {
                var fields = new[]
                {
                    new { heading = (string?)null, text = s.Description },
                    new { heading = (string?)"Motive", text = s.Motive },
                    new { heading = (string?)"Alibi", text = s.Alibi }
                };
                <div class="dossier-item-card is-clickable"
                     data-name="@s.Name"
                     data-image="@s.ImageUrl"
                     data-label="Suspect"
                     data-fields="@System.Text.Json.JsonSerializer.Serialize(fields)">
                    <img src="@s.ImageUrl" alt="@s.Name" />
                    <div class="dossier-item-card__body">
                        <h6>@s.Name</h6>
                        <p>@(s.Description.Length > 80 ? s.Description.Substring(0, 80) + "…" : s.Description)</p>
                    </div>
                </div>
            }
        </div>
    }

    <div class="dossier-section-title">🗣 Witnesses</div>
    @if (!Model.Witnesses.Any())
    {
        <p class="text-muted">No witnesses have come forward.</p>
    }
    else
    {
        <div class="dossier-grid">
            @foreach (var w in Model.Witnesses)
            {
                var fields = new[] { new { heading = (string?)null, text = "\"" + w.Statement + "\"" } };
                <div class="dossier-item-card is-clickable"
                     data-name="@w.Name"
                     data-image="@w.ImageUrl"
                     data-label="Witness"
                     data-fields="@System.Text.Json.JsonSerializer.Serialize(fields)">
                    <img src="@w.ImageUrl" alt="@w.Name" />
                    <div class="dossier-item-card__body">
                        <h6>@w.Name</h6>
                        <p>@(w.Statement.Length > 80 ? w.Statement.Substring(0, 80) + "…" : w.Statement)</p>
                    </div>
                </div>
            }
        </div>
    }

    <div style="margin-top: var(--space-lg);">
        <a asp-action="Index" class="btn-stamp btn-stamp--ghost">← Back to Case Archive</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/file-modal.js" asp-append-version="true"></script>
}